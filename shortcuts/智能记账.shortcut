                "WFValue": {
                  "Value": {
                    "string": "￼",
                    "attachmentsByRange": {
                      "{0, 1}": {
                        "OutputUUID": "ask-action-output"
                      }
                    }
                  },
                  "WFSerializationType": "WFTextTokenString"
                }
              }
            ]
          },
